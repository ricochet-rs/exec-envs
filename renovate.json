{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>ricochet-rs/renovate-config"],
  "automergeType": "branch",
  "ignorePaths": ["releases/**"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/render-(?:r-sysreqs|release)-workflows\\.sh$/"
      ],
      "matchStrings": [
        "(?<depName>codefloe\\.com/crow-plugins/docker-buildx):(?<currentValue>[^\\s}]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.crow(?:/[^/]+)?\\.ya?ml$/"],
      "matchStrings": [
        "(?<depName>\\w+):\\s*(?<currentValue>\\S+)\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s*depName=(?<depName2>\\S+)"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "depNameTemplate": "{{{depName2}}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^release/environments/julia-.*\\.ya?ml$/"],
      "matchStrings": [
        "JULIA_VERSION:\\s*'(?<currentValue>[^']+)'\\s*#\\s*renovate:\\s*julia-current"
      ],
      "depNameTemplate": "JuliaLang/julia",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>\\d+\\.\\d+)\\.\\d+$",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Containerfile$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\nARG \\w+_VERSION=(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["codefloe.com/crow-plugins/docker-buildx"],
      "groupName": "crow and docker-compose",
      "schedule": ["on monday"]
    },
    {
      "description": "Prepare runtime dependency updates in the middle of the month",
      "matchFileNames": ["**/Containerfile*", "release/environments/*.yaml"],
      "schedule": ["* * 15 * *"]
    },
    {
      "matchDepNames": ["JuliaLang/julia"],
      "groupName": "julia stable"
    }
  ]
}
