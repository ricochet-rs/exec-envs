ARG OS_VERSION=10
FROM ghcr.io/astral-sh/uv:0.12.9 AS uv

FROM almalinux:${OS_VERSION}

# renovate: datasource=github-releases depName=quarto-dev/quarto-cli
ARG QUARTO_VERSION=1.10.18
ARG TARGETARCH

COPY --from=uv /uv /uvx /usr/local/bin/

ENV UV_PYTHON_INSTALL_DIR=/opt/python
ENV UV_PYTHON_PREFERENCE=only-managed
ENV UV_CACHE_DIR=/opt/ricochet/cache/uv
ENV PATH=/opt/quarto/bin:${PATH}

WORKDIR /opt/ricochet

RUN mkdir -p /var/lib/ricochet/data /opt/ricochet/data/content /opt/ricochet/cache/uv /opt/python /opt/quarto && \
    dnf install -q -y --nodocs ca-certificates git which && \
    dnf clean all && \
    curl -fsSLo /tmp/quarto.tar.gz "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-${TARGETARCH}.tar.gz" && \
    tar -xzf /tmp/quarto.tar.gz -C /opt/quarto --strip-components=1 && \
    rm /tmp/quarto.tar.gz && \
    uv python install 3.12 3.13 3.14 && \
    ln -sf "$(uv python find 3.12)" /usr/local/bin/python3.12 && \
    ln -sf "$(uv python find 3.13)" /usr/local/bin/python3.13 && \
    ln -sf "$(uv python find 3.14)" /usr/local/bin/python3.14 && \
    ln -sf /usr/local/bin/python3.14 /usr/local/bin/python3

# Ricochet spawns these images under an arbitrary uid whose only group is 0.
RUN chgrp -R 0 /var/lib/ricochet /opt/ricochet && \
    chmod -R g=u /var/lib/ricochet /opt/ricochet

WORKDIR /opt/ricochet/data/content

CMD ["python3"]
