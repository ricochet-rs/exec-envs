  "platform": {
    "id": "alma-10",
    "distribution": "rockylinux",
    "version": "10",
    "family": "alma",
    "exclusions": {
      "sdl2": "AlmaLinux 10 repositories lack SDL2 development headers; SDL3 is not a compatible replacement"
    }
  },
  "exclusions": {
    "blender": "Large 3D application",
    "bowtie2": "Specialist bioinformatics application",
    "chrome": "Browser installation and third-party repositories",
    "cuda": "GPU toolkit requires a dedicated image",
    "dotnet8": "Dedicated .NET runtime",
    "dotnet9": "Dedicated .NET runtime",
    "dotnet10": "Dedicated .NET runtime",
    "imagej": "Large imaging application",
    "latex": "Use a dedicated TeX installation for PDF rendering",
    "qgis": "Large desktop GIS application",
    "saga": "Specialist GIS application",
    "ggobi": "Specialist visualization application; unavailable on Ubuntu 26.04",
    "mysql": "Run database servers separately; retain MySQL client development libraries",
    "sdl2": "AlmaLinux 10 repositories lack SDL2 development headers; SDL3 is not a compatible replacement"
  },
  "overrides": {
    "rust": {
      "reason": "Use distro Rust instead of a per-user rustup installation",
      "packages": ["rust", "cargo"]
    },
    "java": {
      "reason": "Keep Java 21 and configure every bundled R",
      "packages": ["java-21-openjdk-devel"]
    },
    "gdal": {
      "reason": "Use AlmaLinux CRB GDAL; upstream gdal3.4 conflicts with gdal-devel",
      "packages": ["gdal", "gdal-devel"]
    }
  },
