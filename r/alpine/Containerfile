ARG OS_VERSION=3.24
ARG R_44_VERSION=4.4.3
ARG R_45_VERSION=4.5.3
ARG R_46_VERSION=4.6.1
FROM docker.io/devxygmbh/r-alpine:${R_44_VERSION}-${OS_VERSION} AS r44
FROM docker.io/devxygmbh/r-alpine:${R_45_VERSION}-${OS_VERSION} AS r45
FROM docker.io/devxygmbh/r-alpine:${R_46_VERSION}-${OS_VERSION}

# renovate: datasource=github-releases depName=quarto-dev/quarto-cli
ARG QUARTO_VERSION=1.10.18
ARG TARGETARCH

ENV RENV_PATHS_PREFIX_AUTO=TRUE
ENV RENV_PATHS_ROOT=/opt/ricochet/cache/renv
ENV RENV_PATHS_LIBRARY=/opt/ricochet/cache/renv/library
ENV PATH=/opt/quarto/bin:${PATH}
# Quarto ships a glibc-only Deno, so musl images use the Alpine build instead.
ENV QUARTO_DENO=/usr/bin/deno

WORKDIR /opt/ricochet

ARG OS_VERSION
COPY r/sysreqs/alpine-${OS_VERSION}/install.sh /opt/ricochet/install-sysreqs.sh

COPY --from=r44 /opt/R/4.4.3 /opt/R/4.4.3
COPY --from=r45 /opt/R/4.5.3 /opt/R/4.5.3

SHELL ["/bin/ash", "-eo", "pipefail", "-c"]
# The Quarto knitr engine resolves the unversioned Rscript command.
RUN mkdir -p /var/lib/ricochet/data /opt/ricochet/data/content && \
    mkdir -p /opt/ricochet/renv/cache && \
    mkdir -p /opt/quarto && \
    sh /opt/ricochet/install-sysreqs.sh && \
    curl -fsSLo /tmp/quarto.tar.gz "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-${TARGETARCH}.tar.gz" && \
    tar -xzf /tmp/quarto.tar.gz -C /opt/quarto --strip-components=1 && \
    rm /tmp/quarto.tar.gz && \
    ln -sf /opt/R/4.4.3/bin/R /usr/local/bin/R4.4 && \
    ln -sf /opt/R/4.4.3/bin/Rscript /usr/local/bin/Rscript4.4 && \
    ln -sf /opt/R/4.5.3/bin/R /usr/local/bin/R4.5 && \
    ln -sf /opt/R/4.5.3/bin/Rscript /usr/local/bin/Rscript4.5 && \
    ln -sf /opt/R/4.6.1/bin/R /usr/local/bin/R4.6 && \
    ln -sf /opt/R/4.6.1/bin/Rscript /usr/local/bin/Rscript4.6 && \
    ln -sf "$(R RHOME)/bin/Rscript" /usr/local/bin/Rscript && \
    R4.4 -q -e 'install.packages("renv")' && \
    R4.5 -q -e 'install.packages("renv")' && \
    R4.6 -q -e 'install.packages("renv")'

# Ricochet spawns these images under an arbitrary uid whose only group is 0.
RUN chgrp -R 0 /var/lib/ricochet /opt/ricochet && \
    chmod -R g=u /var/lib/ricochet /opt/ricochet

WORKDIR /opt/ricochet/data/content

CMD ["R"]
