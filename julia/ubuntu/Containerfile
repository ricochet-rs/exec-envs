ARG OS_VERSION=resolute
FROM ubuntu:${OS_VERSION}

ARG JULIA_110_VERSION=1.10
# renovate: julia-current
ARG JULIA_112_VERSION=1.12
# renovate: datasource=github-releases depName=quarto-dev/quarto-cli
ARG QUARTO_VERSION=1.10.18
ARG TARGETARCH

ENV JULIA_DEPOT_PATH=/opt/ricochet/cache/julia
ENV PATH=/opt/quarto/bin:${PATH}
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /opt/ricochet

RUN mkdir -p /var/lib/ricochet/data /opt/ricochet/data/content /opt/ricochet/cache/julia /opt/julia /opt/quarto && \
    apt-get update && \
    apt-get install --no-install-recommends -y ca-certificates curl git build-essential gfortran && \
    rm -rf /var/lib/apt/lists/* && \
    case "${TARGETARCH}" in \
        amd64) JARCH=x86_64; JDIR=x64 ;; \
        arm64) JARCH=aarch64; JDIR=aarch64 ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" >&2 && exit 1 ;; \
    esac && \
    for JULIA_VERSION in "${JULIA_110_VERSION}" "${JULIA_112_VERSION}"; do \
        mkdir -p "/opt/julia/${JULIA_VERSION}"; \
        curl -fsSLo /tmp/julia.tar.gz "https://julialang-s3.julialang.org/bin/linux/${JDIR}/${JULIA_VERSION}/julia-${JULIA_VERSION}-latest-linux-${JARCH}.tar.gz"; \
        tar -xzf /tmp/julia.tar.gz -C "/opt/julia/${JULIA_VERSION}" --strip-components=1; \
        ln -s "/opt/julia/${JULIA_VERSION}/bin/julia" "/usr/local/bin/julia${JULIA_VERSION}"; \
    done && \
    rm /tmp/julia.tar.gz && \
    ln -s "/opt/julia/${JULIA_112_VERSION}/bin/julia" /usr/local/bin/julia && \
    curl -fsSLo /tmp/quarto.tar.gz "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-${TARGETARCH}.tar.gz" && \
    tar -xzf /tmp/quarto.tar.gz -C /opt/quarto --strip-components=1 && \
    rm /tmp/quarto.tar.gz

# Ricochet spawns these images under an arbitrary uid whose only group is 0.
RUN chgrp -R 0 /var/lib/ricochet /opt/ricochet && \
    chmod -R g=u /var/lib/ricochet /opt/ricochet

WORKDIR /opt/ricochet/data/content

CMD ["julia"]
